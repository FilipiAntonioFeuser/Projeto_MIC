void setup(){  
// Configuração registradores interrupção (timer)
  cli(); 
  TCCR1A = 0;
  TCCR1B = 0;
  TCNT1  = 0;
  OCR1A = 249; 
  TCCR1B |= (1 << WGM12); 
  TCCR1B |= (1 << CS11) | (1 << CS10); 
  TIMSK1 |= (1 << OCIE1A); 
  sei();
}

ISR(TIMER1_COMPA_vect) {  //Interrupção necessária para o timer
  static int contador = 0;
  contador++;
  
  if (contador >= 1000) {
    contador = 0;
    troca = true;
  }
 }

void timer(){   //Função Timer
  if (troca == true){
      tempo--;
      troca = false;
      lcd.setCursor(14, 0);
      lcd.print(tempo);
      lcd.print(" ");
    }
  }
