extern LiquidCrystal_I2C lcd;

ISR(TIMER1_COMPA_vect) {  //Interrupção necessária para o timer
  static int contador = 0;
  contador++;
  
  if (contador >= 1000) {
    contador = 0;
    troca = true;
  }
 }

void timer() {
  if (estado < 2 || estado > 5) {
    troca = false;
    return;
  }

  if (troca) {
    troca = false;
    if (tempo > 0) {
      tempo--;
    }

    lcd.setCursor(12, 0);
    if (tempo < 100) lcd.print(" ");
    if (tempo < 10)  lcd.print(" ");
    lcd.print(tempo);
    lcd.print("s");
  }
}
