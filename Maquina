#include <LiquidCrystal_I2C.h>
//referencias definidas nas abas keypad e decode
extern LiquidCrystal_I2C lcd; 
extern String senha;
extern bool confirma;

//váriaveis globais compartilhadas pelos módulos
bool vitoria = false;
int erros = 0;

int estado = 0;
int dificuldade = 1;
int tempo = 0;
volatile bool troca = false;

// Evita reescrever telas estáticas a cada ciclo do loop()
void mostrarTelaUnica(int idTela, const char* linha0, const char* linha1) {
  static int ultimaTela = -1;
  if (ultimaTela != idTela) {
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print(linha0);
    lcd.setCursor(0, 1);
    lcd.print(linha1);
    ultimaTela = idTela;
  }
  if (idTela == -1) ultimaTela = -1;
}

void menu() {
  mostrarTelaUnica(0, "ESCAPE ROOM", "1 - Iniciar");
}

void maquina_estados(){
if (estado == 0){  // Menu principal
  menu();
  if (senha == "1"){
    senha = "";
    confirma = false;
    estado = 1;
}  else if (senha == "7355608") { // Easter Egg CS:GO
      lcd.clear();
      lcd.setCursor(0, 0);
      lcd.print("bingo bango");
      lcd.setCursor(0, 1);
      lcd.print("bongo bish bash");
      senha = "";
      confirma = false;
    }
    return;
  }
// ESTADO 1 Escolha de dificuldade
  if (estado == 1) {
    mostrarTelaUnica(1, "Dificuldade:", "1-Facil 2-Dific.");
    if (senha == "1") {
      dificuldade = 1;
      tempo = 90;
      erros = 0;
      vitoria = false;
      senha = "";
      confirma = false;
      mostrarTelaUnica(-1, "", "");
      estado = 2; // Fácil: NFC -> Decode -> Fios -> Vitória
    } else if (senha == "2") {
      dificuldade = 2;
      tempo = 60;
      erros = 0;
      vitoria = false;
      senha = "";
      confirma = false;
      mostrarTelaUnica(-1, "", "");
      estado = 4; // Difícil: Fios -> Pot -> NFC -> Decode -> Vitória
    }
    return;
  }

  // Derrota por tempo zerado ou limite de erros durante os enigmas (estados 2 a 5)
  if (estado >= 2 && estado <= 5) {
    bool estourouErros = (dificuldade == 1 && erros >= 3) || (dificuldade == 2 && erros >= 2);
    if (tempo <= 0 || estourouErros) {
      tempo = 0;
      senha = "";
      confirma = false;
      estado = 7;
      return;
    }
  }

  // ESTADO 2 Puzzle NFC
  if (estado == 2) {
    nfc();
    if (vitoria) {
      vitoria = false;
      tempo += 25;
      estado = 3;
    }
    return;
  }

  // ESTADO 3 Puzzle Decode
  if (estado == 3) {
    decode();
    if (vitoria) {
      vitoria = false;
      if (dificuldade == 1) {
        tempo += 25;
        estado = 4;
      } else {
        estado = 6;
      }
    }
    return;
  }

  // ESTADO 4 Puzzle Fios
  if (estado == 4) {
    fio();
    if (vitoria) {
      vitoria = false;
      if (dificuldade == 1) {
        estado = 6;
      } else {
        tempo += 25;
        estado = 5;
      }
    }
    return;
  }

  // ESTADO 5 Puzzle Potenciômetro
  if (estado == 5) {
    Potenciometro();
    if (vitoria) {
      vitoria = false;
      tempo += 25;
      estado = 2;
    }
    return;
  }

  // ESTADO 6 Vitória
  if (estado == 6) {
    mostrarTelaUnica(6, "Parabens but", "1 - Menu");
    if (senha == "1") {
      estado = 0;
      erros = 0;
      senha = "";
      confirma = false;
    }
    return;
  }

  // ESTADO 7 Derrota
  if (estado == 7) {
    if (dificuldade == 1) {
      mostrarTelaUnica(7, "derrota humilh.", "1 - Menu");
    } else {
      mostrarTelaUnica(7, "derrota", "1 - Menu");
    }
    if (senha == "1") {
      estado = 0;
      erros = 0;
      senha = "";
      confirma = false;
    }
  }
}

void setup() {
  Serial.begin(9600);

  lcd.init();
  lcd.backlight();

  randomSeed(analogRead(A3)); // antes de configurar o ADC do potenciômetro

  configurarFios();
  configurarPotenciometro();

  // Configuração do Timer1 para interrupção de 1 ms
  cli();
  TCCR1A = 0;
  TCCR1B = 0;
  TCNT1  = 0;
  OCR1A  = 249;
  TCCR1B |= (1 << WGM12);
  TCCR1B |= (1 << CS11) | (1 << CS10);
  TIMSK1 |= (1 << OCIE1A);
  sei();
}

void loop() {
  // Lê o teclado apenas nos estados que usam senha (Menu, Dificuldade, Decode, Fim)
  if (estado == 0 || estado == 1 || estado == 3 || estado >= 6) {
    registrar();
  }

  timer();
  maquina_estados();
}
