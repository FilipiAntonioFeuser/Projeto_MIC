
#include <Wire.h>
#include <LiquidCrystal_I2C.h>
#include <SPI.h>
#include <MFRC522.h>
#include <stdint.h>

// CONFIGURACAO DO LEITOR RFID

#define RFID_SS   10
#define RFID_RST  A0

MFRC522 leitor(RFID_SS, RFID_RST);


// VARIAVEIS GLOBAIS DO PROJETO

extern bool vitoria;
extern int erros;
extern LiquidCrystal_I2C lcd;


// UID DO CARTAO AUTORIZADO

const uint8_t UID_CORRETO[] = {
  0xCB, 0x8F, 0x70, 0x26
};

const uint8_t TAM_UID_CORRETO = sizeof(UID_CORRETO);


// MODULO NFC

void nfc() {

  // Inicializa somente na primeira chamada
  static bool inicializado = false;

  if (!inicializado) {

    lcd.init();
    lcd.backlight();
    lcd.clear();

    lcd.setCursor(0, 0);
    lcd.print("Aproxime cartao");

    SPI.begin();
    leitor.PCD_Init();

    inicializado = true;
  }

  // Verifica se existe um novo cartao
  if (!leitor.PICC_IsNewCardPresent()) {
    return;
  }

  // Realiza a leitura
  if (!leitor.PICC_ReadCardSerial()) {
    return;
  }

  // Verifica o UID
  bool autorizado = (leitor.uid.size == TAM_UID_CORRETO);

  if (autorizado) {

    for (uint8_t i = 0; i < TAM_UID_CORRETO; i++) {

      if (leitor.uid.uidByte[i] != UID_CORRETO[i]) {

        autorizado = false;
        break;
      }
    }
  }

  // Define o resultado
  lcd.clear();

  if (autorizado) {

    vitoria = true;

    lcd.setCursor(0, 0);
    lcd.print("CARTAO CORRETO");

    lcd.setCursor(0, 1);
    lcd.print("Acesso liberado");

  }

  else {

    vitoria = false;
    erros++;

    lcd.setCursor(0, 0);
    lcd.print("CARTAO INCORRETO");

    lcd.setCursor(0, 1);
    lcd.print("Erro +1");
  }

  // Finaliza comunicacao com o cartao
  leitor.PICC_HaltA();
  leitor.PCD_StopCrypto1();

}
