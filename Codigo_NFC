
#include <Wire.h>
#include <LiquidCrystal_I2C.h>
#include <SPI.h>
#include <MFRC522.h>
#include <stdint.h>


// CONFIGURACAO DO LEITOR RFID


#define RFID_SS 10

// 0xFF indica que nao existe GPIO conectado ao RST
MFRC522 leitor(RFID_SS, 0xFF);


// VARIAVEIS GLOBAIS DO PROJETO

extern bool vitoria;
extern int erros;
extern LiquidCrystal_I2C lcd;


// CARTAO AUTORIZADO


const uint8_t UID_CORRETO[] = {
  0xCB, 0x8F, 0x70, 0x26
};

const uint8_t TAM_UID_CORRETO = sizeof(UID_CORRETO);



// MODULO NFC


void nfc() {

  // Controle de inicializacao
  static bool inicializado = false;
  static bool faseAtiva = false;

  // Inicializa o leitor apenas uma vez
  if (!inicializado) {

    SPI.begin();
    leitor.PCD_Init();

    inicializado = true;
  }

  // Identifica a entrada na fase
  if (!faseAtiva) {

    vitoria = false;

    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("Passe cartao");

    faseAtiva = true;
  }

  // Verifica se existe um novo cartao
  if (!leitor.PICC_IsNewCardPresent()) {
    return;
  }

  // Realiza a leitura do cartao
  if (!leitor.PICC_ReadCardSerial()) {
    return;
  }

  // Verifica se o tamanho do UID corresponde
  bool autorizado = (leitor.uid.size == TAM_UID_CORRETO);

  // Compara os bytes do UID
  if (autorizado) {

    for (uint8_t i = 0; i < TAM_UID_CORRETO; i++) {

      if (leitor.uid.uidByte[i] != UID_CORRETO[i]) {

        autorizado = false;
        break;
      }
    }
  }

  // Define o resultado
  lcd.clear();

  if (autorizado) {

    vitoria = true;
    faseAtiva = false;

    lcd.setCursor(0, 0);
    lcd.print("CARTAO CORRETO");

    lcd.setCursor(0, 1);
    lcd.print("Acesso liberado");

  }

  else {

    vitoria = false;
    erros++;

    lcd.setCursor(0, 0);
    lcd.print("CARTAO INCORRETO");

    lcd.setCursor(0, 1);
    lcd.print("Erro +1");
  }

  // Finaliza comunicacao com o cartao
  leitor.PICC_HaltA();
  leitor.PCD_StopCrypto1();

}
