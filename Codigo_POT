
// MÓDULO: POTENCIÔMETRO COM FAIXAS (registradores AVR)
#include <avr/io.h>
#include <avr/interrupt.h>
#include <LiquidCrystal_I2C.h>

#define set_bit(reg, bit) ((reg) |= (1 << (bit)))
#define clr_bit(reg, bit) ((reg) &= ~(1 << (bit)))

// Variáveis globais definidas no arquivo principal (.ino) da máquina de estados
extern bool vitoria;
extern int erros;
extern LiquidCrystal_I2C lcd;

const uint8_t CANAL_ADC = 3;                // A3 = ADC3 (PC3)
const int NUM_FAIXAS    = 8;                // menos faixas = mais fácil
const int FAIXA_ALVO    = 5;                // faixa certa (0 até NUM_FAIXAS-1)
const int FAIXA_PERIGO  = 7;                // faixa perigo 
const unsigned long TEMPO_SEGURAR = 1000;   // ms na faixa certa

const int LARGURA_FAIXA = 1024 / NUM_FAIXAS;  // 128 com 8 faixas
const int HISTERESE     = 12;                 // margem em unidades do ADC

// Variáveis internas do módulo
bool naFaixa = false;
unsigned long inicioAcerto = 0;
int faixaAnterior = -1;
int faixaAtual = -1;
bool emPerigo = false;

// Base de tempo (substitui millis)
volatile unsigned long msContador = 0;

ISR(TIMER2_COMPA_vect) {
  msContador++;
}

unsigned long agora() {
  uint8_t sreg = SREG;   // leitura atômica de 32 bits no AVR
  cli();
  unsigned long t = msContador;
  SREG = sreg;
  return t;
}

// Leitura do ADC 
int lerADC() {
  ADCSRA |= (1 << ADSC);              // inicia conversão
  while (ADCSRA & (1 << ADSC)) { }    // aguarda terminar
  return ADC;                         // 0 a 1023
}

int lerPotSuave() {
  long soma = 0;
  for (int i = 0; i < 8; i++) {
    soma += lerADC();
  }
  return soma / 8;
}

// Chamar uma vez no setup() principal
void configurarPotenciometro() {
  //set_bit(DDRB, PB5);   // D13 (LED de fase concluída) como saída
  //set_bit(DDRB, PB4);   // ADICIONE: D12 (LED de erro) como saída
  clr_bit(DDRC, PC3);   // garante A3 como entrada

  // Configura ADC: referência AVcc, canal A3, prescaler 128 (125 kHz)
  ADMUX  = (1 << REFS0) | (CANAL_ADC & 0x07);
  ADCSRA = (1 << ADEN) | (1 << ADPS2) | (1 << ADPS1) | (1 << ADPS0);
  DIDR0 |= (1 << ADC3D);  // desliga buffer digital apenas do A3 (não afeta A0-A2)

  // Configura Timer2 em modo CTC para gerar 1 ms (16 MHz / 128 = 125 kHz -> OCR2A = 124)
  TCCR2A = (1 << WGM21);
  TCCR2B = (1 << CS22) | (1 << CS20);
  OCR2A  = 124;
  TCNT2  = 0;
  TIMSK2 = (1 << OCIE2A);
  sei();
}

// Chamar na transição de entrada para esta fase
void iniciarFasePotenciometro() {
  vitoria = false;
  naFaixa = false;
  emPerigo = false;     // ADICIONE: reseta a trava de erro ao iniciar
  inicioAcerto = 0;
  faixaAnterior = -1;
  faixaAtual = -1;

  //clr_bit(PORTB, PB5);  // apaga LED da placa ao iniciar a fase
  //clr_bit(PORTB, PB4);  // ADICIONE: apaga LED de erro ao iniciar

  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Alvo:101b 7=BOOM"); // ALTERE esta linha (avisa que 7 explode)
  lcd.setCursor(0, 1);
  lcd.print("Faixa: -/7 (1s)");
}

// Chamar continuamente dentro do estado da fase no loop()
void atualizarPotenciometro() {
  if (vitoria) return;

  int leitura = lerPotSuave();  // 0 a 1023

  // Recalcula a faixa apenas se sair da faixa atual + margem de histerese
  int limiteInf = faixaAtual * LARGURA_FAIXA - HISTERESE;
  int limiteSup = (faixaAtual + 1) * LARGURA_FAIXA + HISTERESE;

  if (faixaAtual == -1 || leitura < limiteInf || leitura >= limiteSup) {
    faixaAtual = (long)leitura * NUM_FAIXAS / 1024;
  }

  if (faixaAtual != faixaAnterior) {
    Serial.print("Faixa atual: ");
    Serial.println(faixaAtual);

    lcd.setCursor(0, 1);
    lcd.print("Faixa: ");
    lcd.print(faixaAtual);
    lcd.print("/7 (1s) ");

    faixaAnterior = faixaAtual;
  }

  // Punição ao encostar no limite máximo (faixa 7)
  if (faixaAtual == FAIXA_PERIGO) {
    if (!emPerigo) {
      emPerigo = true;
      erros++;
      //set_bit(PORTB, PB4);
      lcd.setCursor(0, 1);
      lcd.print("SOBRECARGA! +1  ");
      Serial.println("Sobrecarga na faixa 7! Erro +1");
    }
  } else {
    emPerigo = false;
  }

  // Vitória ao segurar na faixa 5 por 1 segundo
  if (faixaAtual == FAIXA_ALVO) {
    if (!naFaixa) {
      naFaixa = true;
      inicioAcerto = agora();

      lcd.setCursor(0, 1);
      lcd.print("Travando... 1s  ");
    } else if (agora() - inicioAcerto >= TEMPO_SEGURAR) {
      vitoria = true;
      //set_bit(PORTB, PB5);
      Serial.println("Potenciometro calibrado! Fase concluida.");
    }
  } else {
    naFaixa = false;
  }
}
void Potenciometro() {
  static bool faseAtiva = false;
  static unsigned long ultimaChamada = 0;

  // Se acabou de entrar na fase OU se ficou mais de 500ms fora dela (ex: perdeu e reiniciou)
  if (!faseAtiva || (agora() - ultimaChamada > 500)) {
    iniciarFasePotenciometro();  // zera vitoria = false e reseta faixas/tempo
    faseAtiva = true;
  }
  ultimaChamada = agora();

  atualizarPotenciometro();

  if (vitoria) {
    faseAtiva = false;
  }
}
