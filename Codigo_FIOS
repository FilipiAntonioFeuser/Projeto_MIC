
#include <avr/io.h>
#include <avr/interrupt.h>
#include <LiquidCrystal_I2C.h>

#define set_bit(reg, bit) ((reg) |= (1 << (bit)))
#define clr_bit(reg, bit) ((reg) &= ~(1 << (bit)))
#define cpl_bit(reg, bit) ((reg) ^= (1 << (bit)))
#define tst_bit(reg, bit) ((reg) & (1 << (bit)))

#define FIO_CERTO     (1 << 0)               // A0 (PC0)
#define FIOS_ERRADOS  ((1 << 1) | (1 << 2))  // A1 (PC1) e A2 (PC2)

// Variáveis globais compartilhadas com a máquina de estados
extern bool vitoria;
extern int erros;
extern LiquidCrystal_I2C lcd;

// Variáveis internas do módulo
volatile uint8_t estado_anterior = 0;
volatile uint8_t fios_cortados = 0;
uint8_t fios_ja_cortados = 0;

void imprimirFios(uint8_t v) {
  Serial.print((v >> 2) & 1);
  Serial.print((v >> 1) & 1);
  Serial.println(v & 1);
}

ISR(PCINT1_vect) {
  uint8_t atual = PINC & 0b00000111;
  uint8_t mudou = atual ^ estado_anterior;
  fios_cortados |= (mudou & atual);  // registra apenas borda de subida (0 pra 1)
  estado_anterior = atual;
}

//Chamar uma vez no setup()
void configurarFios() {
  set_bit(DDRB, PB5);   // D13 (LED desarmou) como saída
  set_bit(DDRB, PB4);   // D12 (LED erro/explodiu) como saída

  clr_bit(DDRC, PC0);   // A0, A1, A2 como entrada
  clr_bit(DDRC, PC1);
  clr_bit(DDRC, PC2);
  set_bit(PORTC, PC0);  // habilita pull-up interno
  set_bit(PORTC, PC1);
  set_bit(PORTC, PC2);

  __asm__ __volatile__("nop\n\tnop\n\t");
  delay(10);

  PCMSK1 |= (1 << PCINT8) | (1 << PCINT9) | (1 << PCINT10);  // habilita A0, A1, A2 na máscara
}

//Chamar ao entrar na fase (ou ao reiniciar o jogo)
void iniciarFaseFios() {
  cli();
  vitoria = false;
  fios_cortados = 0;
  fios_ja_cortados = 0;
  estado_anterior = PINC & 0b00000111;
  set_bit(PCICR, PCIE1);  // ativa interrupção da porta C
  sei();

  clr_bit(PORTB, PB5);    // apaga LEDs da fase
  clr_bit(PORTB, PB4);

  // Escreve a dica uma única vez ao entrar na fase
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("O primeiro sera");
  lcd.setCursor(0, 1);
  lcd.print("a salvacao.");

  Serial.print("Fase Fios iniciada (A2 A1 A0): ");
  imprimirFios(estado_anterior);

  Serial.print("Fase Fios iniciada (A2 A1 A0): ");
  imprimirFios(estado_anterior);
}

//Chamar repetidamente dentro do estado da fase no loop()
void atualizarFios() {
  // Se a fase já foi vencida, ignora cortes posteriores
  if (vitoria) return;

  if (fios_cortados) {
    cli();
    uint8_t copia = fios_cortados;
    fios_cortados = 0;
    sei();

    // Antitremor -> filtra apenas fios inéditos
    uint8_t novos = copia & ~fios_ja_cortados;
    fios_ja_cortados |= novos;
    copia = novos;
    if (!copia) return;

    // Verifica cada fio errado separadamente (caso dois sejam cortados juntos)
    if (copia & (1 << 1)) {
      erros++;
      set_bit(PORTB, PB4);
      Serial.println("Fio errado A1! Erro +1");
    }
    if (copia & (1 << 2)) {
      erros++;
      set_bit(PORTB, PB4);
      Serial.println("Fio errado A2! Erro +1");
    }

    // Verifica fio certo
    if (copia & FIO_CERTO) {
      vitoria = true;
      set_bit(PORTB, PB5);
      clr_bit(PCICR, PCIE1);  // desativa interrupção da porta C depois de vencer a fase
      Serial.println("Fio certo A0! Fase concluida.");
    }
  }
}
void fio() {
  static bool faseAtiva = false;
  static unsigned long ultimaChamada = 0;

  // Se acabou de entrar na fase OU se ficou mais de 500ms fora dela (ex: perdeu e reiniciou)
  if (!faseAtiva || (agora() - ultimaChamada > 500)) {
    iniciarFaseFios();  // zera vitoria = false, limpa flags e religa PCINT1
    faseAtiva = true;
  }
  ultimaChamada = agora();

  atualizarFios();

  if (vitoria) {
    faseAtiva = false;
  }
}
